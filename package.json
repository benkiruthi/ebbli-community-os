{
  "name": "ebbli-community-os",
  "version": "0.2.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "postcss": "8.5.24",
      "sharp": "0.35.0"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.8": "patches/brace-expansion@5.0.8.patch"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:db": "supabase test db",
    "migration:check": "node scripts/check-migrations.mjs",
    "application:check": "node scripts/count-application-fields.mjs",
    "validate": "pnpm format:check && pnpm migration:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build --force",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.112.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  }
}
